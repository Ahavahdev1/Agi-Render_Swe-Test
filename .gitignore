# Virtual Envs (Impede o upload de pacotes pesados)
venv/
.venv/
env/

# MEA & SRE Exclusions (EXTREMAMENTE IMPORTANTES)
.env                    # Impede o vazamento de chaves secretas para a nuvem
.mea/                   # Ignora banco de dados local ativo e travas de arquivo .lock
uploads/                # Ignora arquivos temporários recebidos
workspace/              # Ignora a pasta de desenvolvimento de testes locais
.aider.*                # Ignora logs e históricos locais do Aider

